{
	"nodes":[
		{"id":"g1","type":"group","label":"ЛЕГЕНДА — как читать доску","x":0,"y":0,"width":1540,"height":870},
		{"id":"h2","type":"text","text":"## Стикеры по статусу","x":48,"y":100,"width":1444,"height":62},
		{"id":"n3","x":48,"y":190,"width":340,"height":142,"type":"text","text":"# УТВЕРЖДЕНО\n### ядро, не трогать","color":"4"},
		{"id":"n4","x":416,"y":190,"width":340,"height":142,"type":"text","text":"# ГИПОТЕЗА\n### проверить","color":"3"},
		{"id":"n5","x":784,"y":190,"width":340,"height":142,"type":"text","text":"# НЕ РЕШЕНО\n### выбрать","color":"1"},
		{"id":"n6","x":1152,"y":190,"width":340,"height":142,"type":"text","text":"# ВОПРОС\n### к обсуждению","color":"6"},
		{"id":"h7","type":"text","text":"## Принципы работы","x":48,"y":392,"width":1444,"height":62},
		{"id":"n8","x":48,"y":482,"width":1444,"height":340,"type":"text","text":"### 01 Начинать не с кадров, а с драматической функции сцены.\n### 02 Каждая сцена должна что-то менять.\n### 03 Решения героя — из мотивации, не из сюжета.\n### 04 Никаких случайных поворотов без подготовки.\n### 05 Отличать внешнюю цель от внутренней.\n### 06 Проверять согласованность действий с характером.\n### 07 Повторяющиеся элементы усиливают тему, а не декорируют.\n### 08 Утверждённые решения и гипотезы хранить отдельно."},
		{"id":"g9","type":"group","label":"ЯДРО — о чём фильм на самом деле","x":1680,"y":0,"width":1540,"height":1178},
		{"id":"h10","type":"text","text":"## Рабочее название · Поверхность · На самом деле · Глубинная тема","x":1728,"y":100,"width":1444,"height":62},
		{"id":"n11","x":1728,"y":190,"width":340,"height":360,"type":"text","text":"## «Большой биток»\n### предварительное","color":"3"},
		{"id":"n12","x":2096,"y":190,"width":340,"height":360,"type":"text","text":"## Бывший боксёр в бедности получает шанс через бильярдный турнир с крупным взносом. Втягивает организатор из криминала, сам в долгах.","color":"4"},
		{"id":"n13","x":2464,"y":190,"width":340,"height":360,"type":"text","text":"## О человеке, который после потери прежней жизни пытается вернуть смысл, но снова выбирает риск и повторяет ошибки.","color":"4"},
		{"id":"n14","x":2832,"y":190,"width":340,"height":360,"type":"text","text":"## Недостаточно один раз пережить ошибку — нужно на ней научиться. Второго шанса может не быть.","color":"4"},
		{"id":"h15","type":"text","text":"## Что зритель должен почувствовать","x":1728,"y":610,"width":1444,"height":62},
		{"id":"n16","x":1728,"y":700,"width":708,"height":140,"type":"text","text":"## Жалость и сочувствие к неплохому человеку, которому не повезло и который не умеет остановиться.","color":"4"},
		{"id":"n17","x":2464,"y":700,"width":708,"height":140,"type":"text","text":"## Финал: «Он мог выбраться, но снова сделал тот же выбор — и теперь может быть слишком поздно».","color":"4"},
		{"id":"h18","type":"text","text":"## Эмоциональная дуга зрителя","x":1728,"y":900,"width":1444,"height":62},
		{"id":"n19","x":1728,"y":990,"width":1444,"height":140,"type":"text","text":"## Интерес → Сочувствие → Надежда → Ощущение, что выберется → Тревога → Понимание, что повторяет ошибку → Сожаление → Осознание цены ошибки."},
		{"id":"g20","type":"group","label":"ВИКТОР — герой. Бывший боксёр, который не умеет останавливаться","x":0,"y":1338,"width":1908,"height":1672},
		{"id":"h21","type":"text","text":"## Кто он сейчас","x":48,"y":1438,"width":1812,"height":62},
		{"id":"n22","x":48,"y":1528,"width":340,"height":184,"type":"text","text":"## Бывший профессиональный боксёр","color":"4"},
		{"id":"n23","x":416,"y":1528,"width":340,"height":184,"type":"text","text":"## Работает охранником в бильярдном клубе и живёт в коморке при нём","color":"4"},
		{"id":"n24","x":784,"y":1528,"width":340,"height":184,"type":"text","text":"## Живёт бедно, депрессивное состояние","color":"4"},
		{"id":"n25","x":1152,"y":1528,"width":340,"height":184,"type":"text","text":"## Потерял то, что делало жизнь интересной","color":"4"},
		{"id":"n26","x":1520,"y":1528,"width":340,"height":184,"type":"text","text":"## Борода, халат, пиво — образ нынешнего состояния","color":"4"},
		{"id":"n27","x":48,"y":1740,"width":340,"height":140,"type":"text","text":"## Раньше: риск, борьба, цель, адреналин","color":"3"},
		{"id":"n28","x":416,"y":1740,"width":340,"height":140,"type":"text","text":"## Сейчас: рутина, бедность, пустота","color":"3"},
		{"id":"n29","x":784,"y":1740,"width":340,"height":140,"type":"text","text":"## Начинает день в коморке при клубе; ночью один катает шары","color":"4"},
		{"id":"h30","type":"text","text":"## Желания — внешнее против внутреннего","x":48,"y":1940,"width":1812,"height":62},
		{"id":"n31","x":48,"y":2030,"width":708,"height":184,"type":"text","text":"# Хочет внешне\n## Денег. Выбраться из бедности.","color":"4"},
		{"id":"n32","x":784,"y":2030,"width":708,"height":184,"type":"text","text":"# Хочет на самом деле\n## Спокойной полноценной жизни","color":"4"},
		{"id":"n33","x":1520,"y":2030,"width":340,"height":184,"type":"text","text":"## Образ: жить у моря или озера, чтобы ничего не тревожило","color":"3"},
		{"id":"h34","type":"text","text":"## Противоречие и недостаток","x":48,"y":2274,"width":1812,"height":62},
		{"id":"n35","x":48,"y":2364,"width":708,"height":140,"type":"text","text":"## Хочет спокойствия, но привык жить через риск и сильные эмоции","color":"1"},
		{"id":"n36","x":784,"y":2364,"width":708,"height":140,"type":"text","text":"## Главный недостаток: не умеет останавливаться и не учится на ошибках","color":"1"},
		{"id":"h37","type":"text","text":"## Прошлое — что рассказать голосом, не показывать","x":48,"y":2564,"width":1812,"height":62},
		{"id":"n38","x":48,"y":2654,"width":708,"height":140,"type":"text","text":"## РЕШЕНО: прошлое не показываем, рассказываем закадровым голосом. Флешбеков нет.","color":"4"},
		{"id":"n39","x":784,"y":2654,"width":340,"height":140,"type":"text","text":"## Был профессиональным боксёром","color":"4"},
		{"id":"n40","x":1152,"y":2654,"width":340,"height":140,"type":"text","text":"## Упорство, привычка идти до конца","color":"4"},
		{"id":"n41","x":1520,"y":2654,"width":340,"height":140,"type":"text","text":"## Отношение к риску","color":"4"},
		{"id":"n42","x":48,"y":2822,"width":708,"height":140,"type":"text","text":"## Подставной бой: Виктор намеренно проиграл; организатор сдал его и свалил на него схему ставок","color":"4"},
		{"id":"n43","x":784,"y":2822,"width":340,"height":140,"type":"text","text":"## Связь бокса с ощущением жизни","color":"4"},
		{"id":"n44","x":1152,"y":2822,"width":340,"height":140,"type":"text","text":"## Разоблачение и лишение лицензии заканчивают карьеру","color":"4"},
		{"id":"g45","type":"group","label":"ОРГАНИЗАТОР — тот, кто втягивает, и сам в петле","x":2048,"y":1338,"width":1908,"height":1292},
		{"id":"h46","type":"text","text":"## Кто он","x":2096,"y":1438,"width":1812,"height":62},
		{"id":"n47","x":2096,"y":1528,"width":340,"height":184,"type":"text","text":"## Связан с подпольными / договорными боями","color":"4"},
		{"id":"n48","x":2464,"y":1528,"width":340,"height":184,"type":"text","text":"## В прошлом организовывал подставные бои с Виктором; под давлением сдал его","color":"4"},
		{"id":"n49","x":2832,"y":1528,"width":340,"height":184,"type":"text","text":"## Сейчас сильно задолжал людям","color":"4"},
		{"id":"n50","x":3200,"y":1528,"width":340,"height":184,"type":"text","text":"## Видит возможность на крупном турнире","color":"3"},
		{"id":"n51","x":3568,"y":1528,"width":340,"height":184,"type":"text","text":"## Ищет человека, умеющего играть в бильярд","color":"3"},
		{"id":"h52","type":"text","text":"## Механика сделки","x":2096,"y":1772,"width":1812,"height":62},
		{"id":"n53","x":2096,"y":1862,"width":708,"height":140,"type":"text","text":"## Большой турнир, крупный взнос, значительный выигрыш","color":"4"},
		{"id":"n54","x":2832,"y":1862,"width":708,"height":140,"type":"text","text":"## Предлагает Виктору участвовать и разделить выигрыш","color":"4"},
		{"id":"h55","type":"text","text":"## Мотивации — рифма","x":2096,"y":2062,"width":1812,"height":62},
		{"id":"n56","x":2096,"y":2152,"width":340,"height":140,"type":"text","text":"## Организатор: закрыть собственные долги","color":"4"},
		{"id":"n57","x":2464,"y":2152,"width":340,"height":140,"type":"text","text":"## Виктор: выбраться из бедности","color":"4"},
		{"id":"n58","x":2832,"y":2152,"width":708,"height":140,"type":"text","text":"## Идея: тот же организатор связан и с боксом, и с бильярдом — ощущение повторения","color":"3"},
		{"id":"h59","type":"text","text":"## Вопросы","x":2096,"y":2352,"width":1812,"height":62},
		{"id":"n60","x":2096,"y":2442,"width":708,"height":140,"type":"text","text":"## Он — глава ОПГ или просто связан с криминалом?","color":"6"},
		{"id":"n61","x":2832,"y":2442,"width":708,"height":140,"type":"text","text":"## Почему организатор выбирает именно Виктора?","color":"6"},
		{"id":"g62","type":"group","label":"МИР И ВИЗУАЛЬНЫЙ ЯЗЫК — бильярд, бокс, мечта о море","x":0,"y":3170,"width":1172,"height":1682},
		{"id":"h63","type":"text","text":"## Бильярдная эстетика","x":48,"y":3270,"width":1076,"height":62},
		{"id":"n64","x":48,"y":3360,"width":340,"height":140,"type":"text","text":"## Стол, шары, кий, зелёное сукно","color":"4"},
		{"id":"n65","x":416,"y":3360,"width":340,"height":140,"type":"text","text":"## Дым, ночная жизнь заведения","color":"4"},
		{"id":"n66","x":784,"y":3360,"width":340,"height":140,"type":"text","text":"## Локальный контрастный свет, отражения","color":"4"},
		{"id":"n67","x":48,"y":3528,"width":340,"height":228,"type":"text","text":"## Крупные планы: руки, деньги, детали","color":"4"},
		{"id":"n68","x":416,"y":3528,"width":340,"height":228,"type":"text","text":"## Лица игроков, напряжение перед ударом","color":"4"},
		{"id":"n69","x":784,"y":3528,"width":340,"height":228,"type":"text","text":"## Закрытый ночной клуб: полутьма, свет над столом, один человек катает шары","color":"4"},
		{"id":"h70","type":"text","text":"## Бокс","x":48,"y":3816,"width":1076,"height":62},
		{"id":"n71","x":48,"y":3906,"width":340,"height":140,"type":"text","text":"## Зал, ринг, перчатки","color":"4"},
		{"id":"n72","x":416,"y":3906,"width":340,"height":140,"type":"text","text":"## Кровь, пот, удары","color":"1"},
		{"id":"n73","x":784,"y":3906,"width":340,"height":140,"type":"text","text":"## Физическая усталость","color":"4"},
		{"id":"n74","x":48,"y":4074,"width":340,"height":140,"type":"text","text":"## Контраст с бильярдом","color":"3"},
		{"id":"h75","type":"text","text":"## Связь и метафора","x":48,"y":4274,"width":1076,"height":62},
		{"id":"n76","x":48,"y":4364,"width":340,"height":228,"type":"text","text":"## Бокс → Бильярд: ставка, противник, техника, давление, риск, момент решения","color":"3"},
		{"id":"n77","x":416,"y":4364,"width":340,"height":228,"type":"text","text":"## ГИПОТЕЗА: бильярд как метафора — один удар меняет положение всей системы","color":"3"},
		{"id":"n78","x":784,"y":4364,"width":340,"height":228,"type":"text","text":"## Метафора жизни: контролируешь один ход, последствия расходятся дальше"},
		{"id":"n79","x":48,"y":4620,"width":340,"height":184,"type":"text","text":"## Проверить: работает ли метафора на всех уровнях сюжета?","color":"6"},
		{"id":"g80","type":"group","label":"АНТАГОНИСТ — не выбирать автоматически","x":1312,"y":3170,"width":804,"height":742},
		{"id":"h81","type":"text","text":"## Варианты","x":1360,"y":3270,"width":708,"height":62},
		{"id":"n82","x":1360,"y":3360,"width":340,"height":238,"type":"text","text":"# Вариант A\n## Организатор / криминальный человек — внешняя угроза","color":"1"},
		{"id":"n83","x":1728,"y":3360,"width":340,"height":238,"type":"text","text":"# Вариант B\n## Система азартных игр и риск как таковой","color":"1"},
		{"id":"n84","x":1360,"y":3626,"width":340,"height":238,"type":"text","text":"# Вариант C\n## Характер самого Виктора — неспособность остановиться","color":"1"},
		{"id":"n85","x":1728,"y":3626,"width":340,"height":238,"type":"text","text":"### Оставить открытым. Возможно, антагонист — комбинация всех трёх."},
		{"id":"g86","type":"group","label":"СЮЖЕТ — 9 этапов, от прошлого к финалу","x":0,"y":5012,"width":3380,"height":1290},
		{"id":"h87","type":"text","text":"## Этапы","x":48,"y":5112,"width":3284,"height":62},
		{"id":"n88","x":48,"y":5202,"width":340,"height":518,"type":"text","text":"# 1. Прошлое и падение\n## Не показываем — рассказываем. Закадровый голос поверх первой сцены: боксёр, характер, риск; подставной проигрыш, предательство организатора, лишение лицензии.\n\n### *Тема: связь с жизнью*","color":"4"},
		{"id":"n89","x":416,"y":5202,"width":340,"height":518,"type":"text","text":"# 2. Нынешняя жизнь\n## То, что на экране с первого кадра: ночной клуб, Виктор-охранник, лестница, халат, борода, холодильник, пиво, шары в полутьме.\n\n### *Тема: пустота*","color":"4"},
		{"id":"n90","x":784,"y":5202,"width":340,"height":518,"type":"text","text":"# 3. Шанс\n## Появляется возможность заработать. Организатор рядом.\n\n### *Тема: выход*","color":"4"},
		{"id":"n91","x":1152,"y":5202,"width":340,"height":518,"type":"text","text":"# 4. Предложение\n## Механика турнира. Большой взнос — большой выигрыш.\n\n### *Тема: ставка*","color":"4"},
		{"id":"n92","x":1520,"y":5202,"width":340,"height":518,"type":"text","text":"# 5. Выбор\n## Виктор САМ выбирает согласиться. Это важно.\n\n### *Тема: сам выбирает*","color":"4"},
		{"id":"n93","x":1888,"y":5202,"width":340,"height":518,"type":"text","text":"# 6. Победа\n## Выигрывает. Момент надежды. Кажется, что выберется.\n\n### *Тема: надежда*","color":"4"},
		{"id":"n94","x":2256,"y":5202,"width":340,"height":518,"type":"text","text":"# 7. Повторение ошибки\n## После успеха снова влипает в риск. Мог остановиться — не остановился.\n\n### *Тема: не научился*","color":"1"},
		{"id":"n95","x":2624,"y":5202,"width":340,"height":518,"type":"text","text":"# 8. Последствия\n## Отбирают деньги / теряет выигрыш. Серьёзный конфликт.\n\n### *Тема: цена*","color":"1"},
		{"id":"n96","x":2992,"y":5202,"width":340,"height":518,"type":"text","text":"# 9. Финал\n## Цена ошибки: смерть ИЛИ жить, но всё потеряно.\n\n### *Тема: слишком поздно*","color":"1"},
		{"id":"n97","x":48,"y":5780,"width":340,"height":184,"type":"text","text":"## Написать короткий, ёмкий текст голоса для первой сцены","color":"6"},
		{"id":"n98","x":416,"y":5780,"width":340,"height":184,"type":"text","text":"## Когда Виктор бреется? Борода — маркер состояния.","color":"6"},
		{"id":"n99","x":1520,"y":5780,"width":340,"height":184,"type":"text","text":"## Конкретная причина выбрать риск?","color":"6"},
		{"id":"n100","x":2256,"y":5780,"width":340,"height":184,"type":"text","text":"## Ключевой момент темы: какую ошибку повторяет?","color":"1"},
		{"id":"n101","x":2992,"y":5780,"width":340,"height":184,"type":"text","text":"## НЕ РЕШЕНО: смерть или потеря всего?","color":"1"},
		{"id":"h102","type":"text","text":"## Арка героя одной строкой","x":48,"y":6024,"width":3284,"height":62},
		{"id":"n103","x":48,"y":6114,"width":3284,"height":140,"type":"text","text":"## Бывший боксёр без цели → бедность, серость → хочет спокойной жизни → видит возможность (бильярд) → выбирает риск → выигрывает → шанс остановиться → повторяет ошибку → теряет деньги / безопасность → финал НЕ РЕШЁН."},
		{"id":"g104","type":"group","label":"СЦЕНЫ — первичные цели и шаблон разбора","x":0,"y":6462,"width":1172,"height":2516},
		{"id":"h105","type":"text","text":"## Первичные цели сцен — разбор в отдельных заметках","x":48,"y":6562,"width":1076,"height":62},
		{"id":"n106","x":48,"y":6652,"width":340,"height":340,"type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 1/Сцена 1. Клуб ночью и закадровый рассказ.md","color":"4"},
		{"id":"n107","x":416,"y":6652,"width":340,"height":340,"type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 2. Быт вне клуба.md","color":"1"},
		{"id":"n108","x":784,"y":6652,"width":340,"height":340,"type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 3. Появление возможности.md","color":"4"},
		{"id":"n109","x":48,"y":7020,"width":340,"height":340,"type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 4. Предложение организатора.md","color":"4"},
		{"id":"n110","x":416,"y":7020,"width":340,"height":340,"type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 5. Выбор Виктора.md","color":"4"},
		{"id":"n111","x":784,"y":7020,"width":340,"height":340,"type":"text","text":"# Сцена 6+ — турнир и после\n## Победа, надежда, повторение ошибки, последствия. Детальная последовательность НЕ РЕШЕНА.","color":"1"},
		{"id":"h112","type":"text","text":"## Шаблон разбора каждой сцены","x":48,"y":7420,"width":1076,"height":62},
		{"id":"n113","x":48,"y":7510,"width":1076,"height":460,"type":"file","file":"Growth Space/Projects/Большой биток/scenes/Шаблон разбора сцены.md"},
		{"id":"h114","type":"text","text":"## Мотив «спокойная жизнь» — рефрен","x":48,"y":8030,"width":1076,"height":62},
		{"id":"n115","x":48,"y":8120,"width":340,"height":184,"type":"text","text":"## В начале Виктор говорит о мечте (море / озеро)","color":"3"},
		{"id":"n116","x":416,"y":8120,"width":340,"height":184,"type":"text","text":"## В середине — шанс приблизиться","color":"3"},
