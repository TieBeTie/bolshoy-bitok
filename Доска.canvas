		{"id":"h46","type":"text","text":"## Кто он","x":2096,"y":1438,"width":1812,"height":62},
		{"id":"n47","type":"text","text":"## Связан с подпольными / договорными боями","x":2096,"y":1528,"width":340,"height":184,"color":"4"},
		{"id":"n48","type":"text","text":"## В прошлом организовывал подставные бои с Виктором; под давлением сдал его","x":2464,"y":1528,"width":340,"height":184,"color":"4"},
		{"id":"h21","type":"text","text":"## Кто он сейчас","x":48,"y":1438,"width":1812,"height":62},
		{"id":"n22","type":"text","text":"## Бывший профессиональный боксёр","x":48,"y":1528,"width":340,"height":184,"color":"4"},
		{"id":"n23","type":"text","text":"## Работает охранником в бильярдном клубе и живёт в коморке при нём","x":416,"y":1528,"width":340,"height":184,"color":"4"},
		{"id":"h2","type":"text","text":"## Стикеры по статусу","x":48,"y":100,"width":1444,"height":62},
		{"id":"h10","type":"text","text":"## Рабочее название · Поверхность · На самом деле · Глубинная тема","x":1728,"y":100,"width":1444,"height":62},
		{"id":"n3","type":"text","text":"# УТВЕРЖДЕНО\n### ядро, не трогать","x":48,"y":190,"width":340,"height":142,"color":"4"},
		{"id":"n4","type":"text","text":"# ГИПОТЕЗА\n### проверить","x":416,"y":190,"width":340,"height":142,"color":"3"},
		{"id":"h81","type":"text","text":"## Варианты","x":1360,"y":3270,"width":708,"height":62},
		{"id":"n82","type":"text","text":"# Вариант A\n## Организатор / криминальный человек — внешняя угроза","x":1360,"y":3360,"width":340,"height":238,"color":"1"},
		{"id":"n83","type":"text","text":"# Вариант B\n## Система азартных игр и риск как таковой","x":1728,"y":3360,"width":340,"height":238,"color":"1"},
		{"id":"n84","type":"text","text":"# Вариант C\n## Характер самого Виктора — неспособность остановиться","x":1360,"y":3626,"width":340,"height":238,"color":"1"},
		{"id":"n85","type":"text","text":"### Оставить открытым. Возможно, антагонист — комбинация всех трёх.","x":1728,"y":3626,"width":340,"height":238},
		{"id":"h63","type":"text","text":"## Бильярдная эстетика","x":48,"y":3270,"width":1076,"height":62},
		{"id":"n64","type":"text","text":"## Стол, шары, кий, зелёное сукно","x":48,"y":3360,"width":340,"height":140,"color":"4"},
		{"id":"h87","type":"text","text":"## Этапы","x":48,"y":5112,"width":3284,"height":62},
		{"id":"n88","type":"text","text":"# 1. Прошлое и падение\n## Не показываем — рассказываем. Закадровый голос поверх первой сцены: боксёр, характер, риск; подставной проигрыш, предательство организатора, лишение лицензии.\n\n### *Тема: связь с жизнью*","x":48,"y":5202,"width":340,"height":518,"color":"4"},
		{"id":"n89","type":"text","text":"# 2. Нынешняя жизнь\n## То, что на экране с первого кадра: ночной клуб, Виктор-охранник, лестница, халат, борода, холодильник, пиво, шары в полутьме.\n\n### *Тема: пустота*","x":416,"y":5202,"width":340,"height":518,"color":"4"},
		{"id":"h105","type":"text","text":"## Первичные цели сцен — разбор в отдельных заметках","x":48,"y":6562,"width":1076,"height":62},
		{"id":"n106","type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 1/Сцена 1. Клуб ночью и закадровый рассказ.md","x":48,"y":6652,"width":340,"height":340,"color":"4"},
		{"id":"h128","type":"text","text":"## Вопросы","x":1360,"y":6562,"width":2180,"height":62},
		{"id":"n129","type":"text","text":"## Бильярд или покер? Первая сцена уже построена на бильярде — подтвердить","x":1360,"y":6652,"width":340,"height":228,"color":"1"},
		{"id":"n130","type":"text","text":"## Официальный турнир или подпольная игра?","x":1728,"y":6652,"width":340,"height":228,"color":"1"},
		{"id":"n5","type":"text","text":"# НЕ РЕШЕНО\n### выбрать","x":784,"y":190,"width":340,"height":142,"color":"1"},
		{"id":"n6","type":"text","text":"# ВОПРОС\n### к обсуждению","x":1152,"y":190,"width":340,"height":142,"color":"6"},
		{"id":"h7","type":"text","text":"## Принципы работы","x":48,"y":392,"width":1444,"height":62},
		{"id":"n8","type":"text","text":"### 01 Начинать не с кадров, а с драматической функции сцены.\n### 02 Каждая сцена должна что-то менять.\n### 03 Решения героя — из мотивации, не из сюжета.\n### 04 Никаких случайных поворотов без подготовки.\n### 05 Отличать внешнюю цель от внутренней.\n### 06 Проверять согласованность действий с характером.\n### 07 Повторяющиеся элементы усиливают тему, а не декорируют.\n### 08 Утверждённые решения и гипотезы хранить отдельно.","x":48,"y":482,"width":1444,"height":340},
		{"id":"n11","type":"text","text":"## «Большой биток»\n### предварительное","x":1728,"y":190,"width":340,"height":360,"color":"3"},
		{"id":"n12","type":"text","text":"## Бывший боксёр в бедности получает шанс через бильярдный турнир с крупным взносом. Втягивает организатор из криминала, сам в долгах.","x":2096,"y":190,"width":340,"height":360,"color":"4"},
		{"id":"n13","type":"text","text":"## О человеке, который после потери прежней жизни пытается вернуть смысл, но снова выбирает риск и повторяет ошибки.","x":2464,"y":190,"width":340,"height":360,"color":"4"},
		{"id":"n14","type":"text","text":"## Недостаточно один раз пережить ошибку — нужно на ней научиться. Второго шанса может не быть.","x":2832,"y":190,"width":340,"height":360,"color":"4"},
		{"id":"h15","type":"text","text":"## Что зритель должен почувствовать","x":1728,"y":610,"width":1444,"height":62},
		{"id":"n16","type":"text","text":"## Жалость и сочувствие к неплохому человеку, которому не повезло и который не умеет остановиться.","x":1728,"y":700,"width":708,"height":140,"color":"4"},
		{"id":"n17","type":"text","text":"## Финал: «Он мог выбраться, но снова сделал тот же выбор — и теперь может быть слишком поздно».","x":2464,"y":700,"width":708,"height":140,"color":"4"},
		{"id":"h18","type":"text","text":"## Эмоциональная дуга зрителя","x":1728,"y":900,"width":1444,"height":62},
		{"id":"n19","type":"text","text":"## Интерес → Сочувствие → Надежда → Ощущение, что выберется → Тревога → Понимание, что повторяет ошибку → Сожаление → Осознание цены ошибки.","x":1728,"y":990,"width":1444,"height":140},
		{"id":"n24","type":"text","text":"## Живёт бедно, депрессивное состояние","x":784,"y":1528,"width":340,"height":184,"color":"4"},
		{"id":"n25","type":"text","text":"## Потерял то, что делало жизнь интересной","x":1152,"y":1528,"width":340,"height":184,"color":"4"},
		{"id":"n26","type":"text","text":"## Борода, халат, пиво — образ нынешнего состояния","x":1520,"y":1528,"width":340,"height":184,"color":"4"},
		{"id":"n27","type":"text","text":"## Раньше: риск, борьба, цель, адреналин","x":48,"y":1740,"width":340,"height":140,"color":"3"},
		{"id":"n28","type":"text","text":"## Сейчас: рутина, бедность, пустота","x":416,"y":1740,"width":340,"height":140,"color":"3"},
		{"id":"n29","type":"text","text":"## Начинает день в коморке при клубе; ночью один катает шары","x":784,"y":1740,"width":340,"height":140,"color":"4"},
		{"id":"h30","type":"text","text":"## Желания — внешнее против внутреннего","x":48,"y":1940,"width":1812,"height":62},
		{"id":"n31","type":"text","text":"# Хочет внешне\n## Денег. Выбраться из бедности.","x":48,"y":2030,"width":708,"height":184,"color":"4"},
		{"id":"n32","type":"text","text":"# Хочет на самом деле\n## Спокойной полноценной жизни","x":784,"y":2030,"width":708,"height":184,"color":"4"},
		{"id":"n33","type":"text","text":"## Образ: жить у моря или озера, чтобы ничего не тревожило","x":1520,"y":2030,"width":340,"height":184,"color":"3"},
		{"id":"h34","type":"text","text":"## Противоречие и недостаток","x":48,"y":2274,"width":1812,"height":62},
		{"id":"n35","type":"text","text":"## Хочет спокойствия, но привык жить через риск и сильные эмоции","x":48,"y":2364,"width":708,"height":140,"color":"1"},
		{"id":"n36","type":"text","text":"## Главный недостаток: не умеет останавливаться и не учится на ошибках","x":784,"y":2364,"width":708,"height":140,"color":"1"},
		{"id":"h37","type":"text","text":"## Прошлое — что рассказать голосом, не показывать","x":48,"y":2564,"width":1812,"height":62},
		{"id":"n40","type":"text","text":"## Упорство, привычка идти до конца","x":1152,"y":2654,"width":340,"height":140,"color":"4"},
		{"id":"n41","type":"text","text":"## Отношение к риску","x":1520,"y":2654,"width":340,"height":140,"color":"4"},
		{"id":"n42","type":"text","text":"## Подставной бой: Виктор намеренно проиграл; организатор сдал его и свалил на него схему ставок","x":48,"y":2822,"width":708,"height":140,"color":"4"},
		{"id":"n43","type":"text","text":"## Связь бокса с ощущением жизни","x":784,"y":2822,"width":340,"height":140,"color":"4"},
		{"id":"n49","type":"text","text":"## Сейчас сильно задолжал людям","x":2832,"y":1528,"width":340,"height":184,"color":"4"},
		{"id":"n50","type":"text","text":"## Видит возможность на крупном турнире","x":3200,"y":1528,"width":340,"height":184,"color":"3"},
		{"id":"n51","type":"text","text":"## Ищет человека, умеющего играть в бильярд","x":3568,"y":1528,"width":340,"height":184,"color":"3"},
		{"id":"h52","type":"text","text":"## Механика сделки","x":2096,"y":1772,"width":1812,"height":62},
		{"id":"n53","type":"text","text":"## Большой турнир, крупный взнос, значительный выигрыш","x":2096,"y":1862,"width":708,"height":140,"color":"4"},
		{"id":"n54","type":"text","text":"## Предлагает Виктору участвовать и разделить выигрыш","x":2832,"y":1862,"width":708,"height":140,"color":"4"},
