		{"id":"n74","type":"text","text":"## Контраст с бильярдом","x":48,"y":4074,"width":340,"height":140,"color":"3"},
		{"id":"h75","type":"text","text":"## Связь и метафора","x":48,"y":4274,"width":1076,"height":62},
		{"id":"n76","type":"text","text":"## Бокс → Бильярд: ставка, противник, техника, давление, риск, момент решения","x":48,"y":4364,"width":340,"height":228,"color":"3"},
		{"id":"n77","type":"text","text":"## ГИПОТЕЗА: бильярд как метафора — один удар меняет положение всей системы","x":416,"y":4364,"width":340,"height":228,"color":"3"},
		{"id":"n78","type":"text","text":"## Метафора жизни: контролируешь один ход, последствия расходятся дальше","x":784,"y":4364,"width":340,"height":228},
		{"id":"n79","type":"text","text":"## Проверить: работает ли метафора на всех уровнях сюжета?","x":48,"y":4620,"width":340,"height":184,"color":"6"},
		{"id":"n90","type":"text","text":"# 3. Шанс\n## Появляется возможность заработать. Организатор рядом.\n\n### *Тема: выход*","x":784,"y":5202,"width":340,"height":518,"color":"4"},
		{"id":"n91","type":"text","text":"# 4. Предложение\n## Механика турнира. Большой взнос — большой выигрыш.\n\n### *Тема: ставка*","x":1152,"y":5202,"width":340,"height":518,"color":"4"},
		{"id":"n92","type":"text","text":"# 5. Выбор\n## Виктор САМ выбирает согласиться. Это важно.\n\n### *Тема: сам выбирает*","x":1520,"y":5202,"width":340,"height":518,"color":"4"},
		{"id":"n93","type":"text","text":"# 6. Победа\n## Выигрывает. Момент надежды. Кажется, что выберется.\n\n### *Тема: надежда*","x":1888,"y":5202,"width":340,"height":518,"color":"4"},
		{"id":"n94","type":"text","text":"# 7. Повторение ошибки\n## После успеха снова влипает в риск. Мог остановиться — не остановился.\n\n### *Тема: не научился*","x":2256,"y":5202,"width":340,"height":518,"color":"1"},
		{"id":"n95","type":"text","text":"# 8. Последствия\n## Отбирают деньги / теряет выигрыш. Серьёзный конфликт.\n\n### *Тема: цена*","x":2624,"y":5202,"width":340,"height":518,"color":"1"},
		{"id":"n96","type":"text","text":"# 9. Финал\n## Цена ошибки: смерть ИЛИ жить, но всё потеряно.\n\n### *Тема: слишком поздно*","x":2992,"y":5202,"width":340,"height":518,"color":"1"},
		{"id":"n97","type":"text","text":"## Написать короткий, ёмкий текст голоса для первой сцены","x":48,"y":5780,"width":340,"height":184,"color":"6"},
		{"id":"n98","type":"text","text":"## Когда Виктор бреется? Борода — маркер состояния.","x":416,"y":5780,"width":340,"height":184,"color":"6"},
		{"id":"n99","type":"text","text":"## Конкретная причина выбрать риск?","x":1520,"y":5780,"width":340,"height":184,"color":"6"},
		{"id":"n100","type":"text","text":"## Ключевой момент темы: какую ошибку повторяет?","x":2256,"y":5780,"width":340,"height":184,"color":"1"},
		{"id":"n101","type":"text","text":"## НЕ РЕШЕНО: смерть или потеря всего?","x":2992,"y":5780,"width":340,"height":184,"color":"1"},
		{"id":"h102","type":"text","text":"## Арка героя одной строкой","x":48,"y":6024,"width":3284,"height":62},
		{"id":"n103","type":"text","text":"## Бывший боксёр без цели → бедность, серость → хочет спокойной жизни → видит возможность (бильярд) → выбирает риск → выигрывает → шанс остановиться → повторяет ошибку → теряет деньги / безопасность → финал НЕ РЕШЁН.","x":48,"y":6114,"width":3284,"height":140},
		{"id":"n107","type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 2. Быт вне клуба.md","x":416,"y":6652,"width":340,"height":340,"color":"1"},
		{"id":"n108","type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 3. Появление возможности.md","x":784,"y":6652,"width":340,"height":340,"color":"4"},
		{"id":"n109","type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 4. Предложение организатора.md","x":48,"y":7020,"width":340,"height":340,"color":"4"},
		{"id":"n110","type":"file","file":"Growth Space/Projects/Большой биток/scenes/Сцена 5. Выбор Виктора.md","x":416,"y":7020,"width":340,"height":340,"color":"4"},
		{"id":"n111","type":"text","text":"# Сцена 6+ — турнир и после\n## Победа, надежда, повторение ошибки, последствия. Детальная последовательность НЕ РЕШЕНА.","x":784,"y":7020,"width":340,"height":340,"color":"1"},
