		{"id":"n58","type":"text","text":"## Идея: тот же организатор связан и с боксом, и с бильярдом — ощущение повторения","x":2832,"y":2152,"width":708,"height":140,"color":"3"},
		{"id":"h59","type":"text","text":"## Вопросы","x":2096,"y":2352,"width":1812,"height":62},
		{"id":"n60","type":"text","text":"## Он — глава ОПГ или просто связан с криминалом?","x":2096,"y":2442,"width":708,"height":140,"color":"6"},
		{"id":"n61","type":"text","text":"## Почему организатор выбирает именно Виктора?","x":2832,"y":2442,"width":708,"height":140,"color":"6"},
		{"id":"n65","type":"text","text":"## Дым, ночная жизнь заведения","x":416,"y":3360,"width":340,"height":140,"color":"4"},
		{"id":"n66","type":"text","text":"## Локальный контрастный свет, отражения","x":784,"y":3360,"width":340,"height":140,"color":"4"},
		{"id":"n67","type":"text","text":"## Крупные планы: руки, деньги, детали","x":48,"y":3528,"width":340,"height":228,"color":"4"},
		{"id":"n68","type":"text","text":"## Лица игроков, напряжение перед ударом","x":416,"y":3528,"width":340,"height":228,"color":"4"},
		{"id":"n69","type":"text","text":"## Закрытый ночной клуб: полутьма, свет над столом, один человек катает шары","x":784,"y":3528,"width":340,"height":228,"color":"4"},
		{"id":"h70","type":"text","text":"## Бокс","x":48,"y":3816,"width":1076,"height":62},
